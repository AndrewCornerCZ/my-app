// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator clientt {
  provider = "prisma-client-js"
  output   = "./generated/prisma/client"
}

datasource dbb {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Userr {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  username  String     @default("User")
  password  String     @default("")
  userLikes UserLikee[] // Add this line

}

model Postt {
  id           Int           @id @default(autoincrement())
  created_at   DateTime      @default(now())
  text         String
  postHashtags PostHashtagg[]
  likes        Int           @default(0)
  postId       Int?
  authorId     Int
  userLikes    UserLikee[] // Add this line

  PostComment PostCommentt[]
}

model Hashtagg {
  id           Int           @id @default(autoincrement())
  text         String        @unique
  postHashtags PostHashtagg[]
}

model Commentt {
  id          Int           @id @default(autoincrement())
  text        String
  authorId    Int
  createdAt   DateTime      @default(now())
  PostComment PostCommentt[]
}

model PostCommentt {
  postId    Int
  commentId Int

  post    Postt    @relation(fields: [postId], references: [id])
  comment Commentt @relation(fields: [commentId], references: [id])

  @@id([postId, commentId]) // Composite primary key
}

model PostHashtagg {
  postId    Int
  hashtagId Int

  post    Postt    @relation(fields: [postId], references: [id])
  hashtag Hashtagg @relation(fields: [hashtagId], references: [id])

  @@id([postId, hashtagId]) // Composite primary key
}

model UserLikee {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  user      Userr     @relation(fields: [userId], references: [id])
  post      Postt     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}
